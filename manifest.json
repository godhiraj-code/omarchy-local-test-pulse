{
  "schemaVersion": 1,
  "id": "godhiraj.local-test-pulse",
  "name": "Local Test Pulse",
  "version": "0.1.0",
  "author": "Dhiraj Das",
  "license": "MIT",
  "description": "Read-only status for one bounded local test report.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Local Test Pulse",
    "description": "Shows bounded status from one local test report.",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "reportPath": "",
      "format": "auto",
      "refreshSeconds": 60,
      "staleSeconds": 86400
    },
    "schema": [
      {"key": "reportPath", "type": "path", "label": "Report path", "description": "Absolute path to one local report.", "defaultValue": ""},
      {"key": "format", "type": "enum", "label": "Format", "defaultValue": "auto", "options": ["auto", "junit", "pytest", "playwright"]},
      {"key": "refreshSeconds", "type": "integer", "label": "Refresh seconds", "min": 30, "max": 3600, "step": 1, "defaultValue": 60},
      {"key": "staleSeconds", "type": "integer", "label": "Stale after seconds", "min": 60, "max": 604800, "step": 1, "defaultValue": 86400}
    ]
  }
}
